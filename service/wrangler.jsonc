{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "morning-os-calendar-lab-auth",
  "main": "entry.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "LoginSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginSession"] }]
}
